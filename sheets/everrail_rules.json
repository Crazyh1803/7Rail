      "source_table": "tbl_train_balancing",
      "source_field": "Rows.DerailTimerMin.Default",
      "seen_value": "2 s",
      "sevendays_use": "seconds before derailing when far over the limit"
    },
    {
      "id": "rule_critical_energy",
      "source_table": "tbl_train_balancing",
      "source_field": "Rows.CriticalEnergyBatteryThreshold.Default",
      "seen_value": "150000 Wh",
      "sevendays_use": "low-energy warning on the HUD"
    },
    {
